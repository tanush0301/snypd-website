{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "cleanUrls": true,
  "trailingSlash": false,
  "redirects": [
    { "source": "/sign-in", "destination": "/login", "permanent": true },
    { "source": "/sign-up", "destination": "/signup", "permanent": true },
    { "source": "/pricing", "destination": "/plans", "permanent": true },
    { "source": "/filters", "destination": "/dashboard", "permanent": true },
    { "source": "/vinted-prices", "destination": "/vinted-market-report/september-2026", "permanent": true },
    { "source": "/fr/prix-vinted", "destination": "/fr/rapport-marche-vinted/septembre-2026", "permanent": true }
  ],
  "rewrites": [
    { "source": "/favicon.ico", "destination": "/assets/icons/icon-192.png" }
  ],
  "headers": [
    {
      "source": "/(dashboard|account|admin|affiliate|filters|reset-password)",
      "headers": [{ "key": "X-Robots-Tag", "value": "noindex, nofollow" }]
    },
    {
      "source": "/assets/fonts/(.*).woff2",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }]
    }
  ]
}
