{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "cleanUrls": true,
  "trailingSlash": false,
  "redirects": [
    { "source": "/sign-in", "destination": "/login", "permanent": false },
    { "source": "/sign-up", "destination": "/signup", "permanent": false },
    { "source": "/pricing", "destination": "/plans", "permanent": false },
    { "source": "/filters", "destination": "/dashboard", "permanent": false }
  ],
  "rewrites": [
    { "source": "/favicon.ico", "destination": "/assets/icons/icon-192.png" }
  ],
  "headers": [
    {
      "source": "/(dashboard|account|admin|affiliate|filters|reset-password)",
      "headers": [{ "key": "X-Robots-Tag", "value": "noindex, nofollow" }]
    }
  ]
}
