{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "cleanUrls": true,
  "trailingSlash": false,
  "redirects": [
    { "source": "/sign-in", "destination": "/login", "permanent": true },
    { "source": "/sign-up", "destination": "/signup", "permanent": true },
    { "source": "/pricing", "destination": "/plans", "permanent": true },
    { "source": "/filters", "destination": "/dashboard", "permanent": true },
    { "source": "/vinted-prices", "destination": "/vinted-market-report/september-2026", "permanent": true },
    { "source": "/fr/prix-vinted", "destination": "/fr/rapport-marche-vinted/septembre-2026", "permanent": true }
  ],
  "rewrites": [
    { "source": "/favicon.ico", "destination": "/assets/icons/icon-192.png" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "X-Frame-Options", "value": "SAMEORIGIN" },
        { "key": "Permissions-Policy", "value": "camera=(), microphone=(), geolocation=()" }
      ]
    },
    {
      "source": "/(dashboard|account|admin|affiliate|filters|reset-password)",
      "headers": [{ "key": "X-Robots-Tag", "value": "noindex, nofollow" }]
    },
    {
      "source": "/(privacy|terms)",
      "headers": [{ "key": "X-Robots-Tag", "value": "noindex, follow" }]
    },
    {
      "source": "/assets/fonts/(.*).woff2",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }]
    },
    {
      "source": "/assets/og/og-v5.png",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }]
    },
    {
      "source": "/assets/og/og-default.png",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=86400, stale-while-revalidate=604800" }]
    },
    {
      "source": "/assets/(frames|hero|home|icons|img|seo|video)/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=86400, stale-while-revalidate=604800" }]
    }
  ]
}
